@model IEnumerable<QuanLyDoAn.Models.TienDo>

@{
    ViewData["Title"] = "Chi tiết Tiến Độ Đề Tài";
    Layout = "~/views/Shared/_Layout.cshtml";
    var deTai = ViewBag.DeTai as QuanLyDoAn.Models.DeTai;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="fa-solid fa-bars-progress me-2 text-primary"></i> Quản lý tiến độ đề tài</h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/GV/DeTaiDangHuongDan" class="text-decoration-none">Đề tài đang hướng dẫn</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Tiến độ</li>
                </ol>
            </nav>
        </div>
        <a href="/GV/DeTaiDangHuongDan" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left"></i> Quay lại
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tóm tắt Đề tài -->
    <div class="card shadow border-0 mb-4 bg-light">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-7 border-end">
                    <h5 class="text-primary fw-bold mb-2">@deTai?.TenDeTai</h5>
                    <div class="d-flex gap-3 text-muted small">
                        <span><i class="fa-solid fa-user me-1"></i> SV: @(deTai?.SinhVien?.HoTen ?? "---")</span>
                        <span><i class="fa-solid fa-calendar me-1"></i> Bắt đầu: @(deTai?.NgayBatDau.Year > 1 ? deTai.NgayBatDau.ToString("dd/MM/yyyy") : (deTai?.DotDoAn != null ? deTai.DotDoAn.NgayBatDau.ToString("dd/MM/yyyy") : "---"))</span>
                    </div>
                </div>
                <div class="col-md-5 text-md-center mt-3 mt-md-0">
                    @* Tính phần trăm trung bình tạm thời nếu cần thiết *@
                    <h6 class="text-muted mb-1">Cập nhật gần nhất</h6>
                    @if(Model.Any()) {
                        <p class="mb-0 fw-bold">@Model.First().NgayCapNhat.ToString("dd/MM/yyyy HH:mm")</p>
                    } else {
                        <p class="mb-0 fst-italic">Chưa có cập nhật nào</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Timeline Tiến độ -->
    <div class="card shadow border-0">
        <div class="card-header bg-white border-bottom py-3">
            <h5 class="mb-0"><i class="fa-solid fa-timeline text-info me-2"></i> Lịch sử báo cáo công việc</h5>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center p-5 text-muted">
                    <i class="fa-solid fa-box-open fs-1 mb-3 opacity-50"></i>
                    <h5>Sinh viên chưa báo cáo tiến độ nào</h5>
                </div>
            }
            else
            {
                <div class="list-group list-group-flush rounded-bottom">
                    @foreach (var item in Model)
                    {
                        var hasNhanXet = !string.IsNullOrEmpty(item.NhanXetCuaGiangVien);

                        <div class="list-group-item p-4">
                            <div class="d-flex w-100 justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="mb-1 text-dark fw-bold">@item.TenCongViec</h5>
                                    <small class="text-muted"><i class="fa-regular fa-clock me-1"></i> Báo cáo lúc: @item.NgayCapNhat.ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                                <div class="d-flex flex-column align-items-end">
                                    <span class="badge @(item.PhanTramHoanThanh == 100 ? "bg-success" : "bg-primary") mb-2 fs-6">Hoàn thành: @item.PhanTramHoanThanh%</span>
                                    @if(hasNhanXet) {
                                        <span class="badge bg-light text-success border border-success"><i class="fa-solid fa-check"></i> Đã phản hồi</span>
                                    } else {
                                        <span class="badge bg-warning text-dark"><i class="fa-regular fa-hourglass-half"></i> Chờ phản hồi</span>
                                    }
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-7 mb-3 mb-md-0">
                                    <h6 class="text-secondary fw-bold text-uppercase fs-7 mb-2">Nội dung sinh viên báo cáo</h6>
                                    <div class="p-3 bg-light rounded border lh-lg text-justify" style="white-space: pre-line;">
                                        @item.NoiDungDaLam
                                    </div>
                                    @if(!string.IsNullOrEmpty(item.FileMinhChung)) {
                                        <div class="mt-3">
                                            <a href="@item.FileMinhChung" target="_blank" class="btn btn-sm btn-outline-secondary">
                                                <i class="fa-solid fa-paperclip"></i> Tải file đính kèm
                                            </a>
                                        </div>
                                    }
                                </div>
                                <div class="col-md-5">
                                    <h6 class="text-primary fw-bold text-uppercase fs-7 mb-2">Nhận xét của Giảng viên</h6>
                                    @if (hasNhanXet)
                                    {
                                        <div class="p-3 rounded border border-primary bg-primary text-white bg-opacity-10 lh-lg" style="white-space: pre-line;">
                                            @item.NhanXetCuaGiangVien
                                        </div>
                                        <div class="text-end mt-2">
                                            <button class="btn btn-sm btn-link" data-bs-toggle="modal" data-bs-target="#editNhanXetModal-@item.Id">Sửa nhận xét</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="p-4 text-center border rounded border-dashed bg-light opacity-75">
                                            <p class="text-muted small mb-3">Bạn chưa đưa ra phản hồi cho công việc này</p>
                                            <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#nhanXetModal-@item.Id">
                                                <i class="fa-solid fa-pen me-1"></i> Viết nhận xét
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Modal Nhận Xét -->
                        <div class="modal fade" id="@(hasNhanXet ? "edit" : "")nhanXetModal-@item.Id" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content shadow">
                                    <form asp-action="CapNhatNhanXet" asp-route-id="@item.Id" method="post">
                                        <div class="modal-header bg-primary text-white">
                                            <h5 class="modal-title">Phản hồi tiến độ</h5>
                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            <div class="mb-3">
                                                <label class="form-label text-muted"><strong>Công việc:</strong> @item.TenCongViec</label>
                                            </div>
                                            <div class="mb-3">
                                                <label for="nhanXet-@item.Id" class="form-label fw-bold">Nội dung nhận xét <span class="text-danger">*</span></label>
                                                <textarea class="form-control" name="nhanXetCuaGiangVien" id="nhanXet-@item.Id" rows="6" required placeholder="Nhập những góp ý, định hướng chỉnh sửa cho sinh viên...">@item.NhanXetCuaGiangVien</textarea>
                                            </div>
                                        </div>
                                        <div class="modal-footer pb-0 bg-light">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Trở về</button>
                                            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-paper-plane me-1"></i> Gửi nhận xét</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
