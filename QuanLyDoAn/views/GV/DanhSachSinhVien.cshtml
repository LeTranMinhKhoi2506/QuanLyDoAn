@model IEnumerable<QuanLyDoAn.Models.DeTai>

@{
    ViewData["Title"] = "Sinh viên hướng dẫn";
    Layout = "~/views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fa-solid fa-users me-2"></i> Danh sách sinh viên hướng dẫn</h2>
    </div>

    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>MSSV</th>
                            <th>Họ Tên</th>
                            <th>Lớp</th>
                            <th>Đề Tài</th>
                            <th>Trạng Thái</th>
                            <th>Tiến Độ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center">Chưa có sinh viên nào</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.SinhVien?.MaSinhVien</td>
                                    <td>
                                        <strong>@item.SinhVien?.HoTen</strong><br />
                                        <small class="text-muted">@item.SinhVien?.Email</small><br />
                                        <small class="text-muted">@item.SinhVien?.SoDienThoai</small>
                                    </td>
                                    <td>@item.SinhVien?.Lop</td>
                                    <td>@item.TenDeTai</td>
                                    <td>
                                        @if(item.TrangThai == "Chờ duyệt") {
                                            <span class="badge bg-warning text-dark">Chờ duyệt</span>
                                        } else if (item.TrangThai == "Đang thực hiện") {
                                            <span class="badge bg-primary">Đang thực hiện</span>
                                        } else if (item.TrangThai == "Bị từ chối") {
                                            <span class="badge bg-danger">Bị từ chối</span>
                                        }else if (item.TrangThai == "Hoàn thành") {
                                            <span class="badge bg-success">Hoàn thành</span>
                                        } else {
                                            <span class="badge bg-secondary">@item.TrangThai</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="/GV/TienDoChiTiet/@item.Id" class="btn btn-sm btn-info text-white">
                                            <i class="fa-solid fa-list-check"></i> Xem
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
