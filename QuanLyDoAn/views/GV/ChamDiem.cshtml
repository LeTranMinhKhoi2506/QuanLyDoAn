@model IEnumerable<QuanLyDoAn.Models.DeTai>

@{
    ViewData["Title"] = "Chấm điểm Đề Tài";
    Layout = "~/views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fa-solid fa-marker me-2"></i> Chấm điểm Hướng Dẫn</h2>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Đề Tài</th>
                            <th>Sinh Viên</th>
                            <th>Trạng Thái</th>
                            <th>File Báo Cáo</th>
                            <th>Điểm Hướng Dẫn</th>
                            <th class="text-center">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center">Chưa có đề tài nào cần chấm điểm</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@item.TenDeTai</strong>
                                        <br />
                                        <small class="badge bg-secondary">@item.LoaiDeTai</small>
                                    </td>
                                    <td>
                                        @if(item.SinhVien != null)
                                        {
                                            @item.SinhVien.HoTen<br />
                                            <small class="text-muted">(@item.SinhVien.MaSinhVien)</small>
                                        }
                                    </td>
                                    <td>
                                        @if(item.TrangThai == "Hoàn thành")
                                        {
                                            <span class="badge bg-success">Đã hoàn thành</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info text-dark">Chờ chấm điểm</span>
                                        }
                                    </td>
                                    <td>
                                        @if(!string.IsNullOrEmpty(item.FileBaoCao))
                                        {
                                            <a href="@item.FileBaoCao" target="_blank" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-file-pdf"></i> Tải Báo Cáo</a>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Chưa nộp file</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (item.DiemHuongDan.HasValue)
                                        {
                                            <span class="fw-bold text-success fs-5">@item.DiemHuongDan.Value</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#chamDiemModal-@item.Id">
                                            <i class="fa-solid fa-pen-nib"></i> Chấm Điểm
                                        </button>

                                        <!-- Modal Chấm Điểm -->
                                        <div class="modal fade" id="chamDiemModal-@item.Id" tabindex="-1" aria-labelledby="chamDiemModalLabel-@item.Id" aria-hidden="true">
                                            <div class="modal-dialog">
                                                <div class="modal-content text-start">
                                                    <form asp-action="LuuDiemHuongDan" asp-route-id="@item.Id" method="post">
                                                        <div class="modal-header bg-primary text-white">
                                                            <h5 class="modal-title" id="chamDiemModalLabel-@item.Id">Chấm điểm: @item.SinhVien?.HoTen</h5>
                                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <div class="mb-3">
                                                                <label class="form-label">Tên Đề Tài</label>
                                                                <input type="text" class="form-control" value="@item.TenDeTai" disabled />
                                                            </div>
                                                            <div class="mb-3">
                                                                <label for="diemHuongDan-@item.Id" class="form-label fw-bold">Điểm số hướng dẫn (0-10):</label>
                                                                <input type="number" class="form-control" name="diemHuongDan" id="diemHuongDan-@item.Id" 
                                                                       step="0.1" min="0" max="10" 
                                                                       value="@(item.DiemHuongDan ?? 0)" required />
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                                            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-save"></i> Lưu Điểm</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
