@model IEnumerable<QuanLyDoAn.Models.DeTai>

@{
    ViewData["Title"] = "Đề tài đang hướng dẫn";
    Layout = "~/views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fa-solid fa-book-journal-whills me-2"></i> Đề tài đang hướng dẫn</h2>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Tên Đề Tài</th>
                            <th>Mô tả</th>
                            <th>Sinh Viên Đăng Ký</th>
                            <th>Trạng Thái</th>
                            <th>Ngày Duyệt / Bắt Đầu</th>
                            <th class="text-center">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center">Chưa có đề tài nào đang hướng dẫn</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@item.TenDeTai</strong>
                                        <br />
                                        <small class="badge bg-secondary">@item.LoaiDeTai</small>
                                    </td>
                                    <td>@item.MoTaDeTai</td>
                                    <td>
                                        @if(item.SinhVien != null)
                                        {
                                            @item.SinhVien.HoTen <br />
                                            <span class="text-muted"><i class="fa-regular fa-envelope"></i> @item.SinhVien.Email</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Không xác định</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.TrangThai == "Đang thực hiện" || item.TrangThai == "Đã duyệt") {
                                            <span class="badge bg-primary">Đang thực hiện</span>
                                        } else if (item.TrangThai == "Yêu cầu chỉnh sửa") {
                                            <span class="badge bg-warning text-dark">Chỉnh sửa</span>
                                        } else if (item.TrangThai == "Đã nộp báo cáo") {
                                            <span class="badge bg-info text-dark">Đã nộp báo cáo</span>
                                        } else {
                                            <span class="badge bg-secondary">@item.TrangThai</span>
                                        }
                                    </td>
                                    <td>
                                        @(item.NgayDuyet.HasValue ? item.NgayDuyet.Value.ToString("dd/MM/yyyy") : item.NgayBatDau.ToString("dd/MM/yyyy"))
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-2">
                                            <a href="/GV/TienDoChiTiet/@item.Id" class="btn btn-sm btn-info text-white" title="Quản lý tiến độ">
                                                <i class="fa-solid fa-list-check"></i> Tiến độ
                                            </a>
                                            <a href="/GV/DeTaiChiTiet/@item.Id" class="btn btn-sm btn-secondary" title="Xem chi tiết">
                                                <i class="fa-solid fa-eye"></i> Chi tiết
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
