@model IEnumerable<QuanLyDoAn.Models.DotDoAn>

@{
    ViewData["Title"] = "Quản lý Đợt Đồ Án";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-calendar-alt me-2"></i>Quản lý Đợt Đồ Án</h1>
        <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i> Thêm đợt mới</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Danh sách đợt đồ án / luận văn</h6>
        </div>
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>Chưa có đợt đồ án nào. Hãy thêm đợt mới.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Tên đợt</th>
                                <th>Loại</th>
                                <th>Học kỳ</th>
                                <th>Năm học</th>
                                <th>Thời gian</th>
                                <th>Hạn đăng ký</th>
                                <th>Trạng thái</th>
                                <th>Số đề tài</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var dot in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@dot.TenDot</td>
                                    <td>
                                        @if (dot.LoaiDot == "Đồ án")
                                        {
                                            <span class="badge bg-info">@dot.LoaiDot</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">@dot.LoaiDot</span>
                                        }
                                    </td>
                                    <td>@dot.HocKy</td>
                                    <td>@dot.NamHoc</td>
                                    <td>
                                        <small>
                                            @dot.NgayBatDau.ToString("dd/MM/yyyy")<br/>
                                            → @dot.NgayKetThuc.ToString("dd/MM/yyyy")
                                        </small>
                                    </td>
                                    <td>
                                        <small>@dot.HanDangKyDeTai.ToString("dd/MM/yyyy")</small>
                                    </td>
                                    <td>
                                        @if (dot.DaKhoa)
                                        {
                                            <span class="badge bg-dark"><i class="fas fa-lock me-1"></i>Đã khóa</span>
                                        }
                                        else if (dot.TrangThai == "Đang mở")
                                        {
                                            <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>Đang mở</span>
                                        }
                                        else if (dot.TrangThai == "Đã đóng")
                                        {
                                            <span class="badge bg-secondary">Đã đóng</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">Chưa mở</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-primary">@dot.DeTais.Count</span>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@dot.Id" class="btn btn-info" title="Chi tiết">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            @if (!dot.DaKhoa)
                                            {
                                                <a asp-action="Edit" asp-route-id="@dot.Id" class="btn btn-warning" title="Sửa">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                            }
                                            <a asp-action="ThongKe" asp-route-id="@dot.Id" class="btn btn-success" title="Thống kê">
                                                <i class="fas fa-chart-bar"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
