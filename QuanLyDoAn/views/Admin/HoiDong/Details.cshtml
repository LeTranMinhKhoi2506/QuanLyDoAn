@model QuanLyDoAn.Models.HoiDong
@{ ViewData["Title"] = "Chi Tiết Hội Đồng"; }

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-users-viewfinder me-2"></i>@Model.TenHoiDong</h1>
        <div class="d-flex gap-2">
            @if (!Model.DaKhoa)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm"><i class="fas fa-edit me-1"></i>Sửa</a>
                <form asp-action="KhoaHoiDong" asp-route-id="@Model.Id" method="post" class="d-inline"
                      onsubmit="return confirm('Khóa hội đồng? Sau khi khóa không thể thêm/sửa dữ liệu.')">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-dark btn-sm"><i class="fas fa-lock me-1"></i>Khóa hội đồng</button>
                </form>
            }
            <a asp-action="Manage" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Quay lại</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <div class="row">
        <!-- Thông tin chung -->
        <div class="col-md-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3"><h6 class="m-0 font-weight-bold text-primary">Thông tin hội đồng</h6></div>
                <div class="card-body">
                    <p><strong>Tên:</strong> @Model.TenHoiDong</p>
                    <p><strong>Đợt đồ án:</strong> @(Model.DotDoAn?.TenDot ?? "—")</p>
                    <p><strong>Mô tả:</strong> @(string.IsNullOrEmpty(Model.MoTa) ? "—" : Model.MoTa)</p>
                    <p><strong>Ngày tạo:</strong> @Model.NgayTao.ToString("dd/MM/yyyy")</p>
                    <p><strong>Trạng thái:</strong>
                        @if (Model.DaKhoa)
                        {
                            <span class="badge bg-dark"><i class="fas fa-lock me-1"></i>Đã khóa</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Đang hoạt động</span>
                        }
                    </p>
                </div>
            </div>
        </div>

        <!-- Thành viên -->
        <div class="col-md-8">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-primary">Thành viên hội đồng (@Model.ThanhViens.Count)</h6>
                    @if (!Model.DaKhoa)
                    {
                        <a asp-action="QuanLyThanhVien" asp-route-id="@Model.Id" class="btn btn-sm btn-primary">
                            <i class="fas fa-user-plus me-1"></i>Quản lý thành viên
                        </a>
                    }
                </div>
                <div class="card-body">
                    @if (!Model.ThanhViens.Any())
                    {
                        <p class="text-muted">Chưa có thành viên nào.</p>
                    }
                    else
                    {
                        <table class="table table-sm table-bordered">
                            <thead class="table-light">
                                <tr><th>Giảng viên</th><th>Mã GV</th><th>Vai trò</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var tv in Model.ThanhViens)
                                {
                                    <tr>
                                        <td>@tv.GiangVien?.HoTen</td>
                                        <td>@tv.GiangVien?.MaGiangVien</td>
                                        <td>
                                            @{
                                                var badgeClass = tv.VaiTro switch {
                                                    "Chủ tịch" => "bg-danger",
                                                    "Thư ký" => "bg-warning text-dark",
                                                    "Phản biện" => "bg-info",
                                                    _ => "bg-secondary"
                                                };
                                            }
                                            <span class="badge @badgeClass">@tv.VaiTro</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Đề tài -->
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">Đề tài được chấm (@Model.DeTaisDuocCham.Count)</h6>
            @if (!Model.DaKhoa)
            {
                <div class="d-flex gap-2">
                    <a asp-action="GanDeTai" asp-route-id="@Model.Id" class="btn btn-sm btn-success">
                        <i class="fas fa-link me-1"></i>Gán đề tài
                    </a>
                    <a asp-action="LichBaoVe" asp-route-id="@Model.Id" class="btn btn-sm btn-info">
                        <i class="fas fa-calendar me-1"></i>Sắp lịch bảo vệ
                    </a>
                    <a asp-action="NhapDiem" asp-route-id="@Model.Id" class="btn btn-sm btn-warning">
                        <i class="fas fa-marker me-1"></i>Nhập điểm
                    </a>
                </div>
            }
            <a asp-action="KetQua" asp-route-id="@Model.Id" class="btn btn-sm btn-primary">
                <i class="fas fa-chart-bar me-1"></i>Xem kết quả
            </a>
        </div>
        <div class="card-body">
            @if (!Model.DeTaisDuocCham.Any())
            {
                <p class="text-muted">Chưa có đề tài nào được gán.</p>
            }
            else
            {
                <table class="table table-sm table-bordered">
                    <thead class="table-light">
                        <tr><th>Mã đề tài</th><th>Tên đề tài</th><th>Sinh viên</th><th>GVHD</th><th>Lịch bảo vệ</th><th>Thao tác</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var dt in Model.DeTaisDuocCham)
                        {
                            var lich = Model.LichBaoVes.FirstOrDefault(l => l.DeTaiId == dt.Id);
                            <tr>
                                <td>@dt.MaDeTai</td>
                                <td>@dt.TenDeTai</td>
                                <td>@dt.SinhVien?.HoTen</td>
                                <td>@dt.GiangVien?.HoTen</td>
                                <td>
                                    @if (lich != null)
                                    {
                                        <small>@lich.ThoiGianBaoVe.ToString("dd/MM/yyyy HH:mm") - @lich.PhongBaoVe</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Chưa có lịch</span>
                                    }
                                </td>
                                <td>
                                    @if (!Model.DaKhoa)
                                    {
                                        <form asp-action="HuyGanDeTai" method="post" class="d-inline"
                                              onsubmit="return confirm('Hủy gán đề tài này?')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="deTaiId" value="@dt.Id" />
                                            <input type="hidden" name="hoiDongId" value="@Model.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Hủy gán</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
