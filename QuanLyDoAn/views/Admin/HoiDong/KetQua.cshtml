@model QuanLyDoAn.Models.HoiDong
@{
    ViewData["Title"] = "Kết Quả Chấm Hội Đồng";
    var dsDiem = (IEnumerable<QuanLyDoAn.Models.DiemHoiDong>)ViewBag.DsDiem;
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-chart-bar me-2"></i>Kết Quả: @Model.TenHoiDong</h1>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Quay lại</a>
    </div>

    @if (Model.DaKhoa)
    {
        <div class="alert alert-dark"><i class="fas fa-lock me-2"></i>Hội đồng đã khóa. Chỉ xem kết quả.</div>
    }

    @foreach (var dt in Model.DeTaisDuocCham)
    {
        var diemDeTai = dsDiem.Where(d => d.DeTaiId == dt.Id).ToList();
        <div class="card shadow mb-4">
            <div class="card-header py-2">
                <span class="fw-bold">@dt.MaDeTai - @dt.TenDeTai</span>
                <small class="text-muted ms-3">SV: @dt.SinhVien?.HoTen</small>
            </div>
            <div class="card-body">
                @if (!diemDeTai.Any())
                {
                    <p class="text-muted">Chưa có điểm nào được nhập.</p>
                }
                else
                {
                    <table class="table table-bordered table-sm">
                        <thead class="table-light">
                            <tr>
                                <th>Giảng viên</th>
                                <th>Vai trò</th>
                                <th>Báo cáo (30%)</th>
                                <th>Thuyết trình (20%)</th>
                                <th>Sản phẩm (30%)</th>
                                <th>Trả lời (20%)</th>
                                <th class="text-primary">Điểm tổng</th>
                                <th>Nhận xét</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var diem in diemDeTai)
                            {
                                var vaiTro = Model.ThanhViens.FirstOrDefault(tv => tv.GiangVienId == diem.GiangVienId)?.VaiTro ?? "—";
                                <tr>
                                    <td>@diem.GiangVien?.HoTen</td>
                                    <td><span class="badge bg-secondary">@vaiTro</span></td>
                                    <td>@diem.DiemBaoCao.ToString("0.##")</td>
                                    <td>@diem.DiemThuyetTrinh.ToString("0.##")</td>
                                    <td>@diem.DiemSanPham.ToString("0.##")</td>
                                    <td>@diem.DiemTraLoiCauHoi.ToString("0.##")</td>
                                    <td class="fw-bold text-primary">@diem.DiemTong.ToString("0.##")</td>
                                    <td><small>@(string.IsNullOrEmpty(diem.NhanXet) ? "—" : diem.NhanXet)</small></td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="6" class="text-end fw-bold">Điểm trung bình hội đồng:</td>
                                <td class="fw-bold text-success fs-6">@diemDeTai.Average(d => d.DiemTong).ToString("0.##")</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                }
            </div>
        </div>
    }

    @if (!Model.DeTaisDuocCham.Any())
    {
        <div class="alert alert-info">Chưa có đề tài nào được gán vào hội đồng.</div>
    }
</div>
