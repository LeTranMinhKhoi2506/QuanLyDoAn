@model QuanLyDoAn.Models.HoiDong
@{ ViewData["Title"] = "Sắp Lịch Bảo Vệ"; }

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-calendar me-2"></i>Lịch Bảo Vệ: @Model.TenHoiDong</h1>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Quay lại</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    @if (Model.DotDoAn != null)
    {
        <div class="alert alert-info small">
            <i class="fas fa-info-circle me-1"></i>
            Thời gian đợt đồ án: <strong>@Model.DotDoAn.NgayBatDau.ToString("dd/MM/yyyy")</strong> đến <strong>@Model.DotDoAn.NgayKetThuc.ToString("dd/MM/yyyy")</strong>
        </div>
    }

    @if (!Model.DeTaisDuocCham.Any())
    {
        <div class="alert alert-warning"><i class="fas fa-exclamation-triangle me-2"></i>Chưa có đề tài nào được gán vào hội đồng.</div>
    }
    else
    {
        @foreach (var dt in Model.DeTaisDuocCham)
        {
            var lich = Model.LichBaoVes.FirstOrDefault(l => l.DeTaiId == dt.Id);
            <div class="card shadow mb-3">
                <div class="card-header py-2 d-flex justify-content-between align-items-center">
                    <span class="fw-bold">@dt.MaDeTai - @dt.TenDeTai</span>
                    <small class="text-muted">SV: @dt.SinhVien?.HoTen</small>
                </div>
                <div class="card-body">
                    <form asp-action="LuuLichBaoVe" method="post" class="row g-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="hoiDongId" value="@Model.Id" />
                        <input type="hidden" name="deTaiId" value="@dt.Id" />
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Thời gian bảo vệ <span class="text-danger">*</span></label>
                            <input type="datetime-local" name="thoiGianBaoVe" class="form-control"
                                   value="@(lich != null ? lich.ThoiGianBaoVe.ToString("yyyy-MM-ddTHH:mm") : "")" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Phòng bảo vệ <span class="text-danger">*</span></label>
                            <input type="text" name="phongBaoVe" class="form-control"
                                   value="@(lich?.PhongBaoVe ?? "")" placeholder="VD: A101" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Ghi chú</label>
                            <input type="text" name="ghiChu" class="form-control" value="@(lich?.GhiChu ?? "")" />
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fas fa-save me-1"></i>@(lich != null ? "Cập nhật" : "Lưu")
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        }
    }
</div>
