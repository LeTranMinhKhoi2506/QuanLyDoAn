@model QuanLyDoAn.Models.HoiDong
@{ ViewData["Title"] = "Sửa Hội Đồng"; }

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-edit me-2"></i>Sửa Hội Đồng</h1>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i> Quay lại</a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-body">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div class="mb-3">
                    <label asp-for="TenHoiDong" class="form-label fw-bold">Tên hội đồng <span class="text-danger">*</span></label>
                    <input asp-for="TenHoiDong" class="form-control" />
                    <span asp-validation-for="TenHoiDong" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="DotDoAnId" class="form-label fw-bold">Đợt đồ án <span class="text-danger">*</span></label>
                    <select asp-for="DotDoAnId" class="form-select">
                        <option value="">-- Chọn đợt đồ án --</option>
                        @foreach (var dot in (IEnumerable<QuanLyDoAn.Models.DotDoAn>)ViewBag.DotDoAns)
                        {
                            <option value="@dot.Id">@dot.TenDot (@dot.NamHoc)</option>
                        }
                    </select>
                    <span asp-validation-for="DotDoAnId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="MoTa" class="form-label fw-bold">Mô tả</label>
                    <textarea asp-for="MoTa" class="form-control" rows="3"></textarea>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i> Lưu</button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>
