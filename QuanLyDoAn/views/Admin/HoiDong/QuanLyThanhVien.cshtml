@model QuanLyDoAn.Models.HoiDong
@{ ViewData["Title"] = "Quản Lý Thành Viên Hội Đồng"; }

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-user-plus me-2"></i>Thành Viên: @Model.TenHoiDong</h1>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Quay lại</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <div class="row">
        <!-- Form thêm thành viên -->
        <div class="col-md-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3"><h6 class="m-0 font-weight-bold text-primary">Thêm thành viên</h6></div>
                <div class="card-body">
                    <form asp-action="ThemThanhVien" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="hoiDongId" value="@Model.Id" />
                        <div class="mb-3">
                            <label class="form-label fw-bold">Giảng viên <span class="text-danger">*</span></label>
                            <select name="giangVienId" class="form-select" required>
                                <option value="">-- Chọn giảng viên --</option>
                                @foreach (var gv in (IEnumerable<QuanLyDoAn.Models.GiangVien>)ViewBag.GiangViens)
                                {
                                    <option value="@gv.Id">@gv.HoTen (@gv.MaGiangVien)</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Vai trò <span class="text-danger">*</span></label>
                            <select name="vaiTro" class="form-select" required>
                                <option value="">-- Chọn vai trò --</option>
                                <option value="Chủ tịch">Chủ tịch</option>
                                <option value="Thư ký">Thư ký</option>
                                <option value="Ủy viên">Ủy viên</option>
                                <option value="Phản biện">Phản biện</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary w-100"><i class="fas fa-plus me-1"></i>Thêm</button>
                    </form>
                    <div class="mt-3 alert alert-info small">
                        <strong>Lưu ý:</strong><br/>
                        - Tối thiểu 3 thành viên<br/>
                        - Chỉ 1 Chủ tịch, 1 Thư ký<br/>
                        - Không trùng giảng viên
                    </div>
                </div>
            </div>
        </div>

        <!-- Danh sách thành viên hiện tại -->
        <div class="col-md-8">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Danh sách thành viên (@Model.ThanhViens.Count)</h6>
                </div>
                <div class="card-body">
                    @if (!Model.ThanhViens.Any())
                    {
                        <p class="text-muted">Chưa có thành viên nào.</p>
                    }
                    else
                    {
                        <table class="table table-bordered table-hover">
                            <thead class="table-light">
                                <tr><th>Họ tên</th><th>Mã GV</th><th>Bộ môn</th><th>Vai trò</th><th>Thao tác</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var tv in Model.ThanhViens)
                                {
                                    <tr>
                                        <td>@tv.GiangVien?.HoTen</td>
                                        <td>@tv.GiangVien?.MaGiangVien</td>
                                        <td>@tv.GiangVien?.BoMon</td>
                                        <td>
                                            @{
                                                var badgeClass = tv.VaiTro switch {
                                                    "Chủ tịch" => "bg-danger",
                                                    "Thư ký" => "bg-warning text-dark",
                                                    "Phản biện" => "bg-info",
                                                    _ => "bg-secondary"
                                                };
                                            }
                                            <span class="badge @badgeClass">@tv.VaiTro</span>
                                        </td>
                                        <td>
                                            <form asp-action="XoaThanhVien" method="post" class="d-inline"
                                                  onsubmit="return confirm('Xóa thành viên này?')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="thanhVienId" value="@tv.Id" />
                                                <input type="hidden" name="hoiDongId" value="@Model.Id" />
                                                <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
