@model QuanLyDoAn.Models.GiangVien

@{
    ViewData["Title"] = "Chỉnh sửa Giảng Viên";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                <h6 class="m-0 font-weight-bold text-primary">Chỉnh sửa thông tin giảng viên #@Model.Id</h6>
                <a asp-action="Manage" class="btn btn-sm btn-secondary"><i class="fa-solid fa-arrow-left me-1"></i> Quay lại</a>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold"></div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="MaGiangVien" class="form-label fw-bold">Mã Giảng Viên</label>
                            <input asp-for="MaGiangVien" class="form-control" />
                            <span asp-validation-for="MaGiangVien" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="HoTen" class="form-label fw-bold">Họ và Tên</label>
                            <input asp-for="HoTen" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label fw-bold">Email</label>
                            <input asp-for="Email" type="email" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="SoDienThoai" class="form-label fw-bold">Số Điện Thoại</label>
                            <input asp-for="SoDienThoai" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="BoMon" class="form-label fw-bold">Bộ Môn</label>
                            <input asp-for="BoMon" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="HocVi" class="form-label fw-bold">Học Vị</label>
                            <select asp-for="HocVi" class="form-select">
                                <option value="Cử nhân">Cử nhân</option>
                                <option value="Thạc sĩ">Thạc sĩ</option>
                                <option value="Tiến sĩ">Tiến sĩ</option>
                                <option value="Phó Giáo sư">Phó Giáo sư</option>
                                <option value="Giáo sư">Giáo sư</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="TrangThai" class="form-label fw-bold">Trạng Thái</label>
                            <select asp-for="TrangThai" class="form-select">
                                <option value="Đang hoạt động">Đang hoạt động</option>
                                <option value="Ngừng hoạt động">Ngừng hoạt động</option>
                            </select>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label asp-for="GioiHanSinhVien" class="form-label fw-bold">Giới hạn SV hướng dẫn</label>
                            <input asp-for="GioiHanSinhVien" type="number" min="1" max="20" class="form-control" />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label asp-for="GioiHanDeTai" class="form-label fw-bold">Giới hạn đề tài</label>
                            <input asp-for="GioiHanDeTai" type="number" min="1" max="20" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="SoLuongSinhVienDangHuongDan" class="form-label fw-bold">SV đang hướng dẫn</label>
                            <input asp-for="SoLuongSinhVienDangHuongDan" type="number" min="0" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="UserId" class="form-label fw-bold text-success"><i class="fa-solid fa-link me-1"></i> ID Tài Khoản</label>
                            <input asp-for="UserId" class="form-control border-success" />
                        </div>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary px-4"><i class="fa-solid fa-floppy-disk me-1"></i> Lưu thay đổi</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
