@model QuanLyDoAn.Models.GiangVien

@{
    ViewData["Title"] = "Chi tiết Giảng Viên";
    var isLocked = Model.User?.Role == "Inactive";
    var dsSinhVien = Model.DeTaisHuongDan.Where(d => d.SinhVien != null).Select(d => d.SinhVien).Distinct().ToList();
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                <h6 class="m-0 font-weight-bold text-primary"><i class="fa-solid fa-user-tie me-2"></i>Chi tiết Giảng Viên</h6>
                <div>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-primary"><i class="fa-solid fa-pen-to-square me-1"></i> Chỉnh sửa</a>
                    <a asp-action="Manage" class="btn btn-sm btn-secondary"><i class="fa-solid fa-arrow-left me-1"></i> Quay lại</a>
                </div>
            </div>
            <div class="card-body">
                <div class="row mb-4">
                    <div class="col-md-6">
                        <table class="table table-bordered">
                            <tr>
                                <th class="w-40 bg-light">Mã GV</th>
                                <td class="fw-bold">@Model.MaGiangVien</td>
                            </tr>
                            <tr>
                                <th class="bg-light">Họ Tên</th>
                                <td class="fw-bold text-primary">@Model.HoTen</td>
                            </tr>
                            <tr>
                                <th class="bg-light">Email</th>
                                <td>@Model.Email</td>
                            </tr>
                            <tr>
                                <th class="bg-light">Điện Thoại</th>
                                <td>@Model.SoDienThoai</td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <table class="table table-bordered">
                            <tr>
                                <th class="w-40 bg-light">Bộ Môn</th>
                                <td>@Model.BoMon</td>
                            </tr>
                            <tr>
                                <th class="bg-light">Học Vị</th>
                                <td><span class="badge bg-info">@Model.HocVi</span></td>
                            </tr>
                            <tr>
                                <th class="bg-light">Trạng Thái</th>
                                <td>
                                    @if (isLocked)
                                    {
                                        <span class="badge bg-danger">Bị khóa</span>
                                    }
                                    else if (Model.TrangThai == "Ngừng hoạt động")
                                    {
                                        <span class="badge bg-secondary">Ngừng hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Đang hoạt động</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <th class="bg-light">Tài Khoản</th>
                                <td>@Model.User?.Username</td>
                            </tr>
                        </table>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-4">
                        <div class="card border-primary">
                            <div class="card-body text-center">
                                <h6 class="text-muted">Giới hạn SV hướng dẫn</h6>
                                <h3 class="text-primary fw-bold">@Model.GioiHanSinhVien</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-success">
                            <div class="card-body text-center">
                                <h6 class="text-muted">SV đang hướng dẫn</h6>
                                <h3 class="@(Model.SoLuongSinhVienDangHuongDan >= Model.GioiHanSinhVien ? "text-danger" : "text-success") fw-bold">
                                    @Model.SoLuongSinhVienDangHuongDan
                                </h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-info">
                            <div class="card-body text-center">
                                <h6 class="text-muted">Đề tài đang phụ trách</h6>
                                <h3 class="@(Model.DeTaisHuongDan.Count >= Model.GioiHanDeTai ? "text-danger" : "text-info") fw-bold">
                                    @Model.DeTaisHuongDan.Count / @Model.GioiHanDeTai
                                </h3>
                            </div>
                        </div>
                    </div>
                </div>

                <h5 class="mb-3"><i class="fa-solid fa-users me-2"></i>Danh sách sinh viên đang hướng dẫn (@dsSinhVien.Count)</h5>
                <div class="table-responsive mb-4">
                    <table class="table table-bordered table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Mã SV</th>
                                <th>Họ Tên</th>
                                <th>Lớp</th>
                                <th>Email</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sv in dsSinhVien)
                            {
                                <tr>
                                    <td>@sv.MaSinhVien</td>
                                    <td class="fw-bold">@sv.HoTen</td>
                                    <td>@sv.Lop</td>
                                    <td>@sv.Email</td>
                                </tr>
                            }
                            @if (!dsSinhVien.Any())
                            {
                                <tr><td colspan="4" class="text-center text-muted py-3">Chưa có sinh viên nào.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>

                <h5 class="mb-3"><i class="fa-solid fa-book me-2"></i>Danh sách đề tài đang phụ trách (@Model.DeTaisHuongDan.Count)</h5>
                <div class="table-responsive">
                    <table class="table table-bordered table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Mã ĐT</th>
                                <th>Tên Đề Tài</th>
                                <th>Sinh Viên</th>
                                <th>Trạng Thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var dt in Model.DeTaisHuongDan)
                            {
                                <tr>
                                    <td>@dt.MaDeTai</td>
                                    <td class="fw-bold">@dt.TenDeTai</td>
                                    <td>@(dt.SinhVien?.HoTen ?? "Chưa có")</td>
                                    <td>
                                        @if (dt.TrangThai == "Đã duyệt") { <span class="badge bg-success">@dt.TrangThai</span> }
                                        else if (dt.TrangThai == "Chờ duyệt") { <span class="badge bg-warning">@dt.TrangThai</span> }
                                        else { <span class="badge bg-secondary">@dt.TrangThai</span> }
                                    </td>
                                </tr>
                            }
                            @if (!Model.DeTaisHuongDan.Any())
                            {
                                <tr><td colspan="4" class="text-center text-muted py-3">Chưa có đề tài nào.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
