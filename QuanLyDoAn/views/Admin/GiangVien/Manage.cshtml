@model IEnumerable<QuanLyDoAn.Models.GiangVien>

@{
    ViewData["Title"] = "Quản lý Giảng Viên";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h3 mb-0 text-gray-800">Danh sách Giảng Viên</h2>
    <a asp-controller="GiangVien" asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="fa-solid fa-plus fa-sm text-white-50 me-1"></i> Thêm giảng viên mới
    </a>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">Tất cả giảng viên</h6>
        <form asp-action="Manage" method="get" class="d-flex gap-2">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Tìm theo mã, tên, email, bộ môn..." style="width:300px" />
            <button type="submit" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-magnifying-glass"></i></button>
            @if (!string.IsNullOrEmpty(ViewBag.Search as string))
            {
                <a asp-action="Manage" class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-xmark"></i></a>
            }
        </form>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover w-100 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Mã GV</th>
                        <th>Họ Tên</th>
                        <th>Bộ Môn</th>
                        <th>Học Vị</th>
                        <th>Email</th>
                        <th class="text-center">SV / Giới hạn</th>
                        <th class="text-center">ĐT / Giới hạn</th>
                        <th class="text-center">Trạng Thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var isLocked = item.User?.Role == "Inactive";
                        var dsSinhVien = item.DeTaisHuongDan.Where(d => d.SinhVien != null).Select(d => d.SinhVien).Distinct().Count();
                        var soDeTai = item.DeTaisHuongDan?.Count ?? 0;
                        <tr class="@(isLocked ? "table-secondary text-muted" : "")">
                            <td>@item.MaGiangVien</td>
                            <td class="fw-bold">@item.HoTen</td>
                            <td>@item.BoMon</td>
                            <td>@item.HocVi</td>
                            <td>@item.Email</td>
                            <td class="text-center">
                                <span class="@(dsSinhVien >= item.GioiHanSinhVien ? "text-danger fw-bold" : "")">
                                    @dsSinhVien / @item.GioiHanSinhVien
                                </span>
                            </td>
                            <td class="text-center">
                                <span class="@(soDeTai >= item.GioiHanDeTai ? "text-danger fw-bold" : "")">
                                    @soDeTai / @item.GioiHanDeTai
                                </span>
                            </td>
                            <td class="text-center">
                                @if (isLocked)
                                {
                                    <span class="badge bg-danger">Bị khóa</span>
                                }
                                else if (item.TrangThai == "Ngừng hoạt động")
                                {
                                    <span class="badge bg-secondary">Ngừng hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Đang hoạt động</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Chi tiết"><i class="fa-solid fa-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Chỉnh sửa"><i class="fa-solid fa-pen-to-square"></i></a>
                                <form asp-action="ToggleLock" asp-route-id="@item.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm @(isLocked ? "btn-outline-success" : "btn-outline-warning")" title="@(isLocked ? "Mở khóa" : "Khóa tài khoản")">
                                        <i class="fa-solid @(isLocked ? "fa-lock-open" : "fa-lock")"></i>
                                    </button>
                                </form>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Xóa"><i class="fa-solid fa-trash-can"></i></a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="9" class="text-center text-muted py-4">Chưa có dữ liệu giảng viên nào.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
