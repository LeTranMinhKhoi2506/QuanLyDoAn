@model QuanLyDoAn.Models.DeTai

@{
    ViewData["Title"] = "Chi tiết Đề Tài";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-folder-open me-2"></i>Chi tiết Đề Tài</h1>
    <a asp-controller="AdminDeTai" asp-action="Manage" class="btn btn-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Quay lại
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <!-- Thông tin đề tài -->
    <div class="col-lg-8">
        <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                <h6 class="m-0 font-weight-bold text-primary">Thông tin đề tài</h6>
                @{
                    var badgeClass = Model.TrangThai switch {
                        "Chờ duyệt"      => "bg-warning text-dark",
                        "Đã duyệt"       => "bg-success",
                        "Đang thực hiện" => "bg-info",
                        "Hoàn thành"     => "bg-primary",
                        "Bị từ chối"     => "bg-danger",
                        _                => "bg-secondary"
                    };
                }
                <span class="badge @badgeClass fs-6">@Model.TrangThai</span>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Mã đề tài</dt>
                    <dd class="col-sm-8">@Model.MaDeTai</dd>

                    <dt class="col-sm-4">Tên đề tài</dt>
                    <dd class="col-sm-8 fw-bold">@Model.TenDeTai</dd>

                    <dt class="col-sm-4">Loại</dt>
                    <dd class="col-sm-8">@Model.LoaiDeTai</dd>

                    <dt class="col-sm-4">Mô tả</dt>
                    <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.MoTaDeTai) ? "—" : Model.MoTaDeTai)</dd>

                    <dt class="col-sm-4">Công nghệ</dt>
                    <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.CongNgheSuDung) ? "—" : Model.CongNgheSuDung)</dd>

                    <dt class="col-sm-4">Thời gian</dt>
                    <dd class="col-sm-8">@Model.NgayBatDau.ToString("dd/MM/yyyy") → @Model.NgayKetThuc.ToString("dd/MM/yyyy")</dd>

                    <dt class="col-sm-4">Đợt đồ án</dt>
                    <dd class="col-sm-8">@(Model.DotDoAn?.TenDot ?? "—")</dd>
                </dl>
            </div>
        </div>

        <!-- Nộp bài -->
        @if (!string.IsNullOrEmpty(Model.FileBaoCao) || !string.IsNullOrEmpty(Model.LinkGitHub))
        {
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Tài nguyên nộp</h6>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        @if (!string.IsNullOrEmpty(Model.FileBaoCao))
                        {
                            <dt class="col-sm-4">Báo cáo</dt>
                            <dd class="col-sm-8"><a href="@Model.FileBaoCao" target="_blank">@Model.FileBaoCao</a></dd>
                        }
                        @if (!string.IsNullOrEmpty(Model.LinkGitHub))
                        {
                            <dt class="col-sm-4">GitHub</dt>
                            <dd class="col-sm-8"><a href="@Model.LinkGitHub" target="_blank">@Model.LinkGitHub</a></dd>
                        }
                        @if (!string.IsNullOrEmpty(Model.LinkDemo))
                        {
                            <dt class="col-sm-4">Demo</dt>
                            <dd class="col-sm-8"><a href="@Model.LinkDemo" target="_blank">@Model.LinkDemo</a></dd>
                        }
                    </dl>
                </div>
            </div>
        }

        <!-- Tiến độ -->
        @if (Model.TienDos.Any())
        {
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Tiến độ (@Model.TienDos.Count mục)</h6>
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Công việc</th>
                                <th>Ngày cập nhật</th>
                                <th>Hoàn thành</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var td in Model.TienDos.OrderByDescending(t => t.NgayCapNhat))
                            {
                                <tr>
                                    <td>@td.TenCongViec</td>
                                    <td><small>@td.NgayCapNhat.ToString("dd/MM/yyyy")</small></td>
                                    <td>
                                        <div class="progress" style="height:18px;">
                                            <div class="progress-bar" style="width:@td.PhanTramHoanThanh%">@td.PhanTramHoanThanh%</div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <!-- Sidebar: người liên quan + hành động -->
    <div class="col-lg-4">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Người liên quan</h6>
            </div>
            <div class="card-body">
                <p class="mb-1"><strong><i class="fas fa-user-graduate me-1"></i>Sinh viên:</strong></p>
                <p class="ms-3">@(Model.SinhVien?.HoTen ?? "Chưa có")</p>

                <p class="mb-1"><strong><i class="fas fa-chalkboard-user me-1"></i>Giảng viên HD:</strong></p>
                <p class="ms-3">
                    @if (Model.GiangVien != null)
                    {
                        @Model.GiangVien.HoTen
                    }
                    else
                    {
                        <span class="text-danger">Chưa phân công</span>
                    }
                </p>

                @if (Model.HoiDong != null)
                {
                    <p class="mb-1"><strong><i class="fas fa-users-viewfinder me-1"></i>Hội đồng:</strong></p>
                    <p class="ms-3">@Model.HoiDong.TenHoiDong</p>
                }
            </div>
        </div>

        <!-- Điểm -->
        @if (Model.DiemHuongDan.HasValue || Model.DiemPhanBien.HasValue || Model.DiemHoiDong.HasValue)
        {
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Điểm số</h6>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-7">Điểm hướng dẫn</dt>
                        <dd class="col-5">@(Model.DiemHuongDan?.ToString("0.0") ?? "—")</dd>
                        <dt class="col-7">Điểm phản biện</dt>
                        <dd class="col-5">@(Model.DiemPhanBien?.ToString("0.0") ?? "—")</dd>
                        <dt class="col-7">Điểm hội đồng</dt>
                        <dd class="col-5">@(Model.DiemHoiDong?.ToString("0.0") ?? "—")</dd>
                    </dl>
                </div>
            </div>
        }

        <!-- Hành động duyệt -->
        @if (Model.TrangThai == "Chờ duyệt")
        {
            <div class="card shadow mb-4 border-warning">
                <div class="card-header py-3 bg-warning text-dark">
                    <h6 class="m-0 font-weight-bold"><i class="fas fa-gavel me-1"></i>Xét duyệt</h6>
                </div>
                <div class="card-body d-grid gap-2">
                    <form asp-controller="AdminDeTai" asp-action="DuyetDeTai" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success w-100"
                                onclick="return confirm('Duyệt đề tài này?')">
                            <i class="fas fa-check me-1"></i>Duyệt đề tài
                        </button>
                    </form>
                    <form asp-controller="AdminDeTai" asp-action="TuChoiDeTai" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger w-100"
                                onclick="return confirm('Từ chối đề tài này?')">
                            <i class="fas fa-times me-1"></i>Từ chối
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>
