@model QuanLyDoAn.Models.User

@{
    ViewData["Title"] = "Chỉnh sửa Tài Khoản";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                <h6 class="m-0 font-weight-bold text-primary">Chỉnh sửa tài khoản #@Model.Id</h6>
                <a asp-controller="TaiKhoan" asp-action="Manage" class="btn btn-sm btn-secondary"><i class="fa-solid fa-arrow-left me-1"></i> Quay lại</a>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold"></div>

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label font-weight-bold">Tên đăng nhập</label>
                        <input asp-for="Username" class="form-control" />
                        <span asp-validation-for="Username" class="text-danger small fw-bold"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PasswordHash" class="form-label font-weight-bold">Mật khẩu</label>
                        <input type="password" asp-for="PasswordHash" class="form-control" placeholder="Nhập mật khẩu mới..." />
                        <span asp-validation-for="PasswordHash" class="text-danger small fw-bold"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Role" class="form-label font-weight-bold">Phân Quyền (Role)</label>
                        <select asp-for="Role" class="form-select">
                            <option value="">-- Chọn quyền --</option>
                            <option value="Admin">Admin</option>
                            <option value="Giảng viên">Giảng viên</option>
                            <option value="Sinh viên">Sinh viên</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger small fw-bold"></span>
                    </div>

                    <hr />
                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary px-4"><i class="fa-solid fa-floppy-disk me-1"></i> Lưu thay đổi</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
