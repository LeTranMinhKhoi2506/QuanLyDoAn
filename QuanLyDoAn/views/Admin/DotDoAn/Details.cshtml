@model QuanLyDoAn.Models.DotDoAn

@{
    ViewData["Title"] = "Chi tiết Đợt Đồ Án";
    var coTheMo = Model.TrangThai == "Chưa mở" && DateTime.Now <= Model.HanDangKyDeTai;
    var coTheDong = Model.TrangThai == "Đang mở";
    var coTheKhoa = !Model.DaKhoa;
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-info-circle me-2"></i>Chi tiết Đợt Đồ Án</h1>
        <a asp-action="Manage" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i> Quay lại</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-primary">Thông tin đợt</h6>
                    @if (!Model.DaKhoa)
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-warning">
                            <i class="fas fa-edit me-1"></i> Chỉnh sửa
                        </a>
                    }
                </div>
                <div class="card-body">
                    <table class="table table-bordered">
                        <tr>
                            <th class="w-25">Tên đợt</th>
                            <td class="fw-bold">@Model.TenDot</td>
                        </tr>
                        <tr>
                            <th>Loại đợt</th>
                            <td>
                                @if (Model.LoaiDot == "Đồ án")
                                {
                                    <span class="badge bg-info">@Model.LoaiDot</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">@Model.LoaiDot</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th>Học kỳ</th>
                            <td>@Model.HocKy</td>
                        </tr>
                        <tr>
                            <th>Năm học</th>
                            <td>@Model.NamHoc</td>
                        </tr>
                        <tr>
                            <th>Ngày bắt đầu</th>
                            <td>@Model.NgayBatDau.ToString("dd/MM/yyyy")</td>
                        </tr>
                        <tr>
                            <th>Ngày kết thúc</th>
                            <td>@Model.NgayKetThuc.ToString("dd/MM/yyyy")</td>
                        </tr>
                        <tr>
                            <th>Hạn đăng ký đề tài</th>
                            <td>
                                @Model.HanDangKyDeTai.ToString("dd/MM/yyyy")
                                @if (DateTime.Now > Model.HanDangKyDeTai)
                                {
                                    <span class="badge bg-danger ms-2">Đã quá hạn</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th>Hạn nộp báo cáo</th>
                            <td>@Model.HanNopBaoCao.ToString("dd/MM/yyyy")</td>
                        </tr>
                        <tr>
                            <th>Trạng thái</th>
                            <td>
                                @if (Model.DaKhoa)
                                {
                                    <span class="badge bg-dark"><i class="fas fa-lock me-1"></i>Đã khóa</span>
                                }
                                else if (Model.TrangThai == "Đang mở")
                                {
                                    <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>Đang mở</span>
                                }
                                else if (Model.TrangThai == "Đã đóng")
                                {
                                    <span class="badge bg-secondary">Đã đóng</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Chưa mở</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th>Ngày tạo</th>
                            <td>@Model.NgayTao.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                        @if (!string.IsNullOrEmpty(Model.MoTa))
                        {
                            <tr>
                                <th>Mô tả</th>
                                <td>@Model.MoTa</td>
                            </tr>
                        }
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Thao tác</h6>
                </div>
                <div class="card-body">
                    @if (coTheMo)
                    {
                        <form asp-action="MoDangKy" method="post" class="mb-2">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-success w-100" onclick="return confirm('Xác nhận mở đợt đăng ký?')">
                                <i class="fas fa-unlock me-1"></i> Mở đợt đăng ký
                            </button>
                        </form>
                    }

                    @if (coTheDong)
                    {
                        <form asp-action="DongDangKy" method="post" class="mb-2">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-warning w-100" onclick="return confirm('Xác nhận đóng đợt đăng ký?')">
                                <i class="fas fa-lock me-1"></i> Đóng đợt đăng ký
                            </button>
                        </form>
                    }

                    @if (coTheKhoa)
                    {
                        <form asp-action="KhoaDot" method="post" class="mb-2">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-dark w-100" onclick="return confirm('CẢNH BÁO: Sau khi khóa sẽ không thể thêm/sửa dữ liệu. Xác nhận khóa đợt?')">
                                <i class="fas fa-lock me-1"></i> Khóa đợt
                            </button>
                        </form>
                    }

                    <hr />

                    <a asp-action="SinhVienTrongDot" asp-route-id="@Model.Id" class="btn btn-info w-100 mb-2">
                        <i class="fas fa-users me-1"></i> Danh sách sinh viên
                    </a>

                    <a asp-action="DeTaiTrongDot" asp-route-id="@Model.Id" class="btn btn-primary w-100 mb-2">
                        <i class="fas fa-book me-1"></i> Danh sách đề tài
                    </a>

                    <a asp-action="ThongKe" asp-route-id="@Model.Id" class="btn btn-success w-100">
                        <i class="fas fa-chart-bar me-1"></i> Thống kê
                    </a>
                </div>
            </div>

            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Tổng quan</h6>
                </div>
                <div class="card-body">
                    <div class="text-center">
                        <h3 class="text-primary">@Model.DeTais.Count</h3>
                        <p class="mb-0">Đề tài trong đợt</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
