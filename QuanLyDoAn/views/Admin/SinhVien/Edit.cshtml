@model QuanLyDoAn.Models.SinhVien

@{
    ViewData["Title"] = "Chỉnh sửa Sinh Viên";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                <h6 class="m-0 font-weight-bold text-primary">Chỉnh sửa thông tin sinh viên #@Model.Id</h6>
                <a asp-controller="SinhVien" asp-action="Manage" class="btn btn-sm btn-secondary"><i class="fa-solid fa-arrow-left me-1"></i> Quay lại</a>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="MaSinhVien" class="form-label font-weight-bold">Mã Sinh Viên</label>
                            <input asp-for="MaSinhVien" class="form-control" placeholder="Nhập MSSV..." />
                            <span asp-validation-for="MaSinhVien" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="HoTen" class="form-label font-weight-bold">Họ và Tên</label>
                            <input asp-for="HoTen" class="form-control" placeholder="Nhập đầy đủ họ tên..." />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Lop" class="form-label font-weight-bold">Lớp</label>
                            <input asp-for="Lop" class="form-control" placeholder="Ví dụ: K66-CNTT" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="KhoaHoc" class="form-label font-weight-bold">Khóa Học</label>
                            <input asp-for="KhoaHoc" class="form-control" placeholder="Ví dụ: K66" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label font-weight-bold">Email</label>
                            <input asp-for="Email" type="email" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="SoDienThoai" class="form-label font-weight-bold">Số Điện Thoại</label>
                            <input asp-for="SoDienThoai" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="TrangThai" class="form-label font-weight-bold">Trạng Thái</label>
                            <select asp-for="TrangThai" class="form-select">
                                <option value="Đang học">Đang học</option>
                                <option value="Bảo lưu">Bảo lưu</option>
                                <option value="Đã tốt nghiệp">Đã tốt nghiệp</option>
                                <option value="Đình chỉ">Đình chỉ</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="UserId" class="form-label font-weight-bold text-success"><i class="fa-solid fa-link me-1"></i> ID Tài Khoản</label>
                            <input asp-for="UserId" class="form-control border-success" />
                        </div>
                    </div>

                    <hr />
                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary px-4"><i class="fa-solid fa-floppy-disk me-1"></i> Lưu thay đổi</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
