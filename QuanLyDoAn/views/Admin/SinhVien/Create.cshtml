@model QuanLyDoAn.Models.SinhVien

@{
    ViewData["Title"] = "Thêm mới Sinh Viên";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                <h6 class="m-0 font-weight-bold text-primary">Tạo Thông Tin Sinh Viên Mới</h6>
                <a href="/SinhVien/Manage" class="btn btn-sm btn-secondary"><i class="fa-solid fa-arrow-left me-1"></i> Quay lại</a>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label font-weight-bold">Mã Sinh Viên</label>
                            <input asp-for="MaSinhVien" class="form-control" required placeholder="Nhập MSSV..." />
                            <span asp-validation-for="MaSinhVien" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label font-weight-bold">Họ và Tên</label>
                            <input asp-for="HoTen" class="form-control" required placeholder="Nhập đầy đủ họ tên..." />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label font-weight-bold">Lớp</label>
                            <input asp-for="Lop" class="form-control" required placeholder="Ví dụ: K66-CNTT" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label font-weight-bold">Khóa Học</label>
                            <input asp-for="KhoaHoc" class="form-control" required placeholder="Ví dụ: K66" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label font-weight-bold">Email</label>
                            <input asp-for="Email" type="email" class="form-control" required placeholder="sinhvien@school.edu.vn" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label font-weight-bold">Số Điện Thoại</label>
                            <input asp-for="SoDienThoai" class="form-control" required placeholder="09xxxx..." />
                        </div>
                        <div class="col-md-12 mb-3">
                            <label class="form-label font-weight-bold">Trạng Thái</label>
                            <select asp-for="TrangThai" class="form-select">
                                <option value="Đang học">Đang học</option>
                                <option value="Bảo lưu">Bảo lưu</option>
                                <option value="Đã tốt nghiệp">Đã tốt nghiệp</option>
                                <option value="Đình chỉ">Đình chỉ</option>
                            </select>
                        </div>

                        <!-- User Account Binding -->
                        <div class="col-md-12 mb-4">
                            <label class="form-label font-weight-bold text-success"><i class="fa-solid fa-link me-1"></i> Liên kết Tài Khoản Hệ Thống (ID Account)</label>
                            <input asp-for="UserId" class="form-control border-success" required placeholder="Nhập ID User của sinh viên (tạo bên mục Tài khoản)" />
                            <div class="form-text text-muted">ID User bắt buộc phải có để map sinh viên vào hệ thống đăng nhập.</div>
                        </div>
                    </div>

                    <hr />
                    <div class="d-flex justify-content-end mb-0">
                        <button type="submit" class="btn btn-primary px-4"><i class="fa-solid fa-floppy-disk me-1"></i> Lưu thông tin</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}