@model QuanLyDoAn.Models.SinhVien

@{
    ViewData["Title"] = "Xoá Sinh Viên";
    bool coDeTai = Model.DeTais.Any();
    bool coDuLieuLienQuan = Model.DeTais.Any(d =>
        d.TienDos.Any() ||
        d.DiemHuongDan.HasValue || d.DiemPhanBien.HasValue || d.DiemHoiDong.HasValue ||
        !string.IsNullOrEmpty(d.FileBaoCao));
    bool choPhepXoaCung = !coDeTai && !coDuLieuLienQuan;
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow mb-4 border-danger">
            <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between bg-danger text-white">
                <h6 class="m-0 font-weight-bold"><i class="fa-solid fa-triangle-exclamation me-2"></i>Xử lý xoá sinh viên</h6>
                <a asp-controller="SinhVien" asp-action="Manage" class="btn btn-sm btn-light"><i class="fa-solid fa-arrow-left me-1"></i> Quay lại</a>
            </div>
            <div class="card-body">
                <table class="table table-bordered mb-4">
                    <tr>
                        <th class="w-25">Mã SV</th>
                        <td>@Model.MaSinhVien</td>
                    </tr>
                    <tr>
                        <th>Họ Tên</th>
                        <td class="fw-bold">@Model.HoTen</td>
                    </tr>
                    <tr>
                        <th>Lớp</th>
                        <td>@Model.Lop</td>
                    </tr>
                    <tr>
                        <th>Email</th>
                        <td>@Model.Email</td>
                    </tr>
                    <tr>
                        <th>Trạng Thái</th>
                        <td>
                            @if (Model.TrangThai == "Đang học") { <span class="badge bg-success">@Model.TrangThai</span> }
                            else { <span class="badge bg-secondary">@Model.TrangThai</span> }
                        </td>
                    </tr>
                </table>

                <div class="alert alert-warning">
                    <h6 class="fw-bold mb-3"><i class="fa-solid fa-info-circle me-2"></i>Tình trạng dữ liệu:</h6>
                    <ul class="mb-0">
                        <li><strong>Đã đăng ký đề tài:</strong> @(coDeTai ? "Có (" + Model.DeTais.Count + " đề tài)" : "Chưa")</li>
                        <li><strong>Có tiến độ/file/điểm:</strong> @(coDuLieuLienQuan ? "Có" : "Không")</li>
                    </ul>
                </div>

                @if (coDuLieuLienQuan)
                {
                    <div class="alert alert-danger">
                        <i class="fa-solid fa-ban me-2"></i><strong>Không cho xoá cứng</strong> - Sinh viên đã có tiến độ, file nộp hoặc điểm.
                        <br/>Bạn chỉ có thể chuyển trạng thái sang <strong>"Ngừng hoạt động"</strong>.
                    </div>
                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" name="action" value="deactivate" />
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-controller="SinhVien" asp-action="Manage" class="btn btn-secondary"><i class="fa-solid fa-xmark me-1"></i> Huỷ</a>
                            <button type="submit" class="btn btn-warning"><i class="fa-solid fa-pause-circle me-1"></i> Chuyển trạng thái "Ngừng hoạt động"</button>
                        </div>
                    </form>
                }
                else if (coDeTai)
                {
                    <div class="alert alert-danger">
                        <i class="fa-solid fa-ban me-2"></i><strong>Không cho xoá cứng</strong> - Sinh viên đã đăng ký đề tài.
                        <br/>Bạn chỉ có thể chuyển trạng thái sang <strong>"Ngừng hoạt động"</strong>.
                    </div>
                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" name="action" value="deactivate" />
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-controller="SinhVien" asp-action="Manage" class="btn btn-secondary"><i class="fa-solid fa-xmark me-1"></i> Huỷ</a>
                            <button type="submit" class="btn btn-warning"><i class="fa-solid fa-pause-circle me-1"></i> Chuyển trạng thái "Ngừng hoạt động"</button>
                        </div>
                    </form>
                }
                else if (Model.TrangThai == "Đang học" || Model.TrangThai == "Bảo lưu")
                {
                    <div class="alert alert-info">
                        <i class="fa-solid fa-lightbulb me-2"></i>Sinh viên mới tạo, chưa có dữ liệu liên quan.
                        <br/>Bạn có thể <strong>xoá cứng</strong> hoặc <strong>chuyển trạng thái</strong>.
                    </div>
                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-controller="SinhVien" asp-action="Manage" class="btn btn-secondary"><i class="fa-solid fa-xmark me-1"></i> Huỷ</a>
                            <button type="submit" name="action" value="deactivate" class="btn btn-warning"><i class="fa-solid fa-pause-circle me-1"></i> Ngừng hoạt động</button>
                            <button type="submit" name="action" value="delete" class="btn btn-danger"><i class="fa-solid fa-trash-can me-1"></i> Xoá cứng</button>
                        </div>
                    </form>
                }
                else
                {
                    <div class="alert alert-success">
                        <i class="fa-solid fa-check-circle me-2"></i>Sinh viên không còn đang học và chưa có dữ liệu liên quan.
                        <br/>Có thể <strong>xoá cứng</strong> hoặc giữ lại với trạng thái hiện tại.
                    </div>
                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-controller="SinhVien" asp-action="Manage" class="btn btn-secondary"><i class="fa-solid fa-xmark me-1"></i> Huỷ</a>
                            <button type="submit" name="action" value="delete" class="btn btn-danger"><i class="fa-solid fa-trash-can me-1"></i> Xoá cứng</button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
