@{
    ViewData["Title"] = "Dashboard Sinh Viên";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h3 mb-0 text-gray-800">Không Gian Làm Việc (Sinh viên)</h2>
</div>

<div class="row" id="noDeTaiAlert" style="display:none;">
    <div class="col-12">
        <div class="alert alert-warning shadow-sm border-left-warning" role="alert">
            <h4 class="alert-heading"><i class="fa-solid fa-triangle-exclamation"></i> Chú ý!</h4>
            <p>Bạn hiện chưa đăng ký hoặc chưa được duyệt đề tài nào.</p>
            <hr>
            <p class="mb-0">Vui lòng vào menu <strong>Đăng ký / đề xuất đề tài</strong> để bắt đầu đồ án của bạn.</p>
            <a href="@Url.Action("DangKyDeXuat", "SV")" class="btn btn-warning mt-3 rounded-pill text-dark fw-bold">Đi đăng ký ngay</a>
        </div>
    </div>
</div>

<div class="row" id="dashboardContent" style="display:none;">
    <div class="col-lg-8 mb-4">
        <!-- Đề tài của tôi -->
        <div class="card shadow mb-4 border-0">
            <div class="card-header py-3 bg-white d-flex align-items-center justify-content-between">
                <h6 class="m-0 font-weight-bold text-primary"><i class="fa-solid fa-laptop-code me-2"></i>Đề tài của tôi</h6>
                <span class="badge bg-primary fs-6 py-2 px-3 rounded-pill" id="dtTrangThai">Đang tải...</span>
            </div>
            <div class="card-body p-4">
                <h3 class="font-weight-bold text-dark mb-3" id="dtTen">Đang tải tên đề tài...</h3>

                <div class="d-flex mb-3 align-items-center">
                    <div class="me-4 text-muted">
                        <i class="fa-solid fa-chalkboard-user me-1"></i> Giảng viên HD:
                    </div>
                    <div class="fs-5 fw-semibold" id="dtGV">Đang tải...</div>
                </div>

                <div class="d-flex mb-3 align-items-center">
                    <div class="me-4 text-muted">
                        <i class="fa-solid fa-calendar-xmark me-1"></i> Hạn nộp báo cáo:
                    </div>
                    <div class="fs-5 fw-semibold text-danger" id="dtHanNop">Đang tải...</div>
                </div>
                
                <div class="d-flex mb-4 align-items-center">
                    <div class="me-4 text-muted">
                        <i class="fa-solid fa-clock me-1"></i> Thời gian còn lại:
                    </div>
                    <div class="fs-5 fw-semibold text-warning" id="dtSoNgayConLai">Đang tải...</div>
                </div>

                <h5 class="small font-weight-bold">Tiến độ hoàn thành <span class="float-end" id="dtPhanTramText">0%</span></h5>
                <div class="progress mb-4" style="height: 25px;">
                    <div id="dtPhanTramBar" class="progress-bar progress-bar-striped progress-bar-animated bg-success" role="progressbar" style="width: 0%" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">0%</div>
                </div>

                <div class="mt-4 pt-3 border-top d-flex gap-3">
                    <a href="@Url.Action("CapNhatTienDo", "SV")" class="btn btn-primary"><i class="fa-solid fa-tasks me-1"></i> Cập nhật tiến độ</a>
                    <a href="@Url.Action("NopBaoCao", "SV")" class="btn btn-outline-success"><i class="fa-solid fa-cloud-arrow-up me-1"></i> Nộp báo cáo</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Nhận xét và Thông báo -->
    <div class="col-lg-4 mb-4">
        <div class="card shadow mb-4 border-0 h-100">
            <div class="card-header py-3 bg-white">
                <h6 class="m-0 font-weight-bold text-primary"><i class="fa-solid fa-comments me-2"></i>Nhận xét mới nhất từ GV</h6>
            </div>
            <div class="card-body">
                <div class="alert alert-secondary border-0 text-dark fst-italic" role="alert" id="dtNhanXet" style="min-height: 100px;">
                    "Đang tải dữ liệu nhận xét..."
                </div>
                <div class="d-grid mt-4">
                    <a href="@Url.Action("LichGapGiangVien", "SV")" class="btn btn-outline-primary"><i class="fa-solid fa-calendar-check me-1"></i> Xin lịch hẹn GV</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $.get("/SV/GetDashboardStats", function (data) {
                if (data.hasDeTai) {
                    $("#dashboardContent").show();
                    $("#noDeTaiAlert").hide();

                    $("#dtTen").text(data.tenDeTai);
                    $("#dtGV").text(data.giangVienHuongDan);

                    var tt = data.trangThai;
                    var badgeClass = 'bg-secondary';
                    if(tt === 'Đang thực hiện') badgeClass = 'bg-primary';
                    else if(tt === 'Hoàn thành') badgeClass = 'bg-success';
                    else if(tt === 'Chờ duyệt') badgeClass = 'bg-warning text-dark';

                    $("#dtTrangThai").text(tt).removeClass('bg-primary bg-secondary bg-success bg-warning text-dark').addClass(badgeClass);

                    $("#dtHanNop").text(data.hanNop);

                    if (data.soNgayConLai > 0) {
                        $("#dtSoNgayConLai").text(data.soNgayConLai + " ngày");
                    } else {
                        $("#dtSoNgayConLai").text("Đã quá hạn").removeClass("text-warning").addClass("text-danger");
                    }

                    var phanTram = data.phanTramTienDo;
                    $("#dtPhanTramText").text(phanTram + "%");
                    $("#dtPhanTramBar").css("width", phanTram + "%").text(phanTram + "%").attr("aria-valuenow", phanTram);

                    $("#dtNhanXet").text('"' + data.nhanXetMoiNhat + '"');
                } else {
                    $("#dashboardContent").hide();
                    $("#noDeTaiAlert").show();
                }
            }).fail(function() {
                // Nếu sinh viên chưa có profile (chưa liên kết User với SinhVien id)
                $("#dashboardContent").hide();
                $("#noDeTaiAlert").show();
            });
        });
    </script>
}