@model IEnumerable<QuanLyDoAn.Models.LichGap>
@{
    ViewData["Title"] = "Lịch xin gặp Giảng viên";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var deTai = ViewBag.DeTai as QuanLyDoAn.Models.DeTai;
}

<div class="container mt-4">
    <h2><i class="fa-solid fa-calendar-days me-2 text-primary"></i>Lịch họp / Xin hẹn Giảng viên</h2>
    <p class="text-muted">Quản lý các cuộc trao đổi trực tiếp và online với TS. @deTai?.GiangVien?.HoTen</p>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-warning mt-3 shadow-sm">
            <i class="fa-solid fa-circle-exclamation me-1"></i> @TempData["Message"]
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success mt-3 shadow-sm">
            <i class="fa-solid fa-check-circle me-1"></i> @TempData["SuccessMessage"]
        </div>
    }

    <!-- Nút mở form thêm mới -->
    <div class="d-flex justify-content-end mb-3">
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addLichModal">
            <i class="fa-solid fa-calendar-plus me-1"></i> Đăng ký hẹn mới
        </button>
    </div>

    <!-- Danh sách lịch hẹn -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">Danh sách các cuộc hẹn của bạn</h5>
        </div>
        <div class="card-body">
            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-secondary mb-0 border-0 bg-light p-4 text-center">
                    <i class="fa-brands fa-creative-commons-zero fs-1 text-muted mb-2 opacity-50"></i>
                    <p class="mb-0 text-muted fst-italic">Bạn chưa có yêu cầu cuộc hẹn nào.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light text-muted">
                            <tr>
                                <th>Thời gian hẹn đề xuất</th>
                                <th>Hình thức dự kiến</th>
                                <th>Nội dung họp</th>
                                <th>Trạng thái & Lời nhắn GV</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark mb-1 fs-5">
                                            @item.NgayGioGap.ToString("HH:mm")
                                        </div>
                                        <div class="small fw-semibold text-primary">
                                            @item.NgayGioGap.ToString("dd/MM/yyyy")
                                        </div>
                                    </td>
                                    <td>
                                        @if (item.HinhThuc == "Online")
                                        {
                                            <span class="badge bg-info text-dark rounded-pill px-3"><i class="fa-solid fa-video me-1"></i>Online</span>
                                        }
                                        else
                                        {
                                            <span class="badge border border-primary text-primary rounded-pill px-3"><i class="fa-solid fa-handshake me-1"></i>Trực tiếp</span>
                                        }
                                    </td>
                                    <td>@item.NoiDung</td>
                                    <td>
                                        @{
                                            var badgeClass = "bg-warning text-dark"; // Chờ duyệt
                                            if (item.TrangThai == "Chấp nhận") badgeClass = "bg-success";
                                            if (item.TrangThai == "Từ chối") badgeClass = "bg-danger";
                                            if (item.TrangThai == "Đổi lịch") badgeClass = "bg-secondary";
                                        }
                                        <span class="badge @badgeClass mb-1">Tuỳ trạng thái: @item.TrangThai</span>
                                        @if (!string.IsNullOrEmpty(item.GhiChu))
                                        {
                                            <div class="small fst-italic mt-1 text-muted border-start ps-2 border-3">
                                                “@item.GhiChu”
                                            </div>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (item.TrangThai == "Chờ duyệt")
                                        {
                                            <form asp-action="HuyLichGap" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc muốn hủy yêu cầu đặt lịch này?');">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Huỷ đơn xin hẹn">
                                                    <i class="fa-solid fa-xmark"></i> Hủy
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-light text-muted" disabled title="Lịch đã được phản hồi, không thể xoá.">
                                                <i class="fa-solid fa-lock"></i> Khóa
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Thêm Lịch Hẹn -->
<div class="modal fade" id="addLichModal" tabindex="-1" aria-labelledby="addLichModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form asp-action="XinLichGap" method="post">
                <div class="modal-header bg-primary text-white border-0">
                    <h5 class="modal-title" id="addLichModalLabel"><i class="fa-solid fa-calendar-plus me-2"></i>Đề xuất cuộc hẹn</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-info small pb-2 border-0 bg-light text-dark shadow-sm">
                        Cuộc hẹn sẽ được gửi đến giảng viên <strong class="text-primary">@deTai?.GiangVien?.HoTen</strong> để chờ xác nhận. Xin lựa chọn thời gian hợp lý.
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Thời gian mong muốn gặp <span class="text-danger">*</span></label>
                        <input type="datetime-local" class="form-control form-control-lg bg-light" name="NgayGioGap" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Hình thức gặp mặt <span class="text-danger">*</span></label>
                        <select class="form-select container-fluid bg-light" name="HinhThuc" required>
                            <option value="Online">Họp Online (Meet/Teams/Zoom)</option>
                            <option value="Trực tiếp">Hẹn Trực tiếp (Trường/Văn phòng khoa)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Xin nội dung / Lý do trao đổi <span class="text-danger">*</span></label>
                        <textarea class="form-control bg-light" name="NoiDung" rows="3" required placeholder="Nêu rõ lý do cần gặp: báo cáo lỗi code, cần duyệt sườn luận văn, review lại tính năng đăng nhập..."></textarea>
                    </div>

                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary px-4"><i class="fa-solid fa-paper-plane me-2"></i>Gửi yêu cầu xin hẹn</button>
                </div>
            </form>
        </div>
    </div>
</div>
