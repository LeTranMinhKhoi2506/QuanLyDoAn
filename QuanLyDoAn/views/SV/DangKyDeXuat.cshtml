@model QuanLyDoAn.Models.DeTai
@{
    ViewData["Title"] = "Đăng ký đề tài";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var dotDoAn = (QuanLyDoAn.Models.DotDoAn)ViewBag.DotDoAn;
}

<div class="container mt-4">
    <h2>Đăng ký / Đề xuất đề tài</h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-warning">
            @TempData["Message"]
        </div>
    }

    <!-- Hiển thị thông tin Đợt đồ án -->
    @if (dotDoAn != null)
    {
        <div class="alert alert-info mt-3">
            <h5 class="alert-heading"><i class="fa-solid fa-info-circle me-2"></i>Thông tin Đợt Đồ Án</h5>
            <div class="row mt-3">
                <div class="col-md-6">
                    <p class="mb-2">
                        <strong>Tên đợt:</strong> <span class="text-primary">@dotDoAn.TenDot</span>
                    </p>
                    <p class="mb-2">
                        <strong>Loại đợt:</strong> @dotDoAn.LoaiDot
                    </p>
                    <p class="mb-2">
                        <strong>Năm học:</strong> @dotDoAn.NamHoc
                    </p>
                    <p class="mb-2">
                        <strong>Học kỳ:</strong> @dotDoAn.HocKy
                    </p>
                </div>
                <div class="col-md-6">
                    <p class="mb-2">
                        <strong>Ngày bắt đầu:</strong> <span class="text-success">@dotDoAn.NgayBatDau.ToString("dd/MM/yyyy")</span>
                    </p>
                    <p class="mb-2">
                        <strong>Ngày kết thúc:</strong> <span class="text-success">@dotDoAn.NgayKetThuc.ToString("dd/MM/yyyy")</span>
                    </p>
                    <p class="mb-2">
                        <strong>Hạn đăng ký đề tài:</strong> <span class="text-danger fw-bold">@dotDoAn.HanDangKyDeTai.ToString("dd/MM/yyyy")</span>
                    </p>
                    <p class="mb-2">
                        <strong>Hạn nộp báo cáo:</strong> <span class="text-danger fw-bold">@dotDoAn.HanNopBaoCao.ToString("dd/MM/yyyy")</span>
                    </p>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(dotDoAn.MoTa))
            {
                <hr />
                <p class="mb-0"><strong>Ghi chú:</strong> @dotDoAn.MoTa</p>
            }
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="DangKyDeXuat" method="post">
                <div class="mb-3">
                    <label asp-for="TenDeTai" class="form-label">Tên đề tài</label>
                    <input asp-for="TenDeTai" class="form-control" required placeholder="Nhập tên đề tài..." />
                    <span asp-validation-for="TenDeTai" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MoTaDeTai" class="form-label">Mô tả tóm tắt</label>
                    <textarea asp-for="MoTaDeTai" class="form-control" rows="4" placeholder="Nhập mô tả chi tiết..."></textarea>
                    <span asp-validation-for="MoTaDeTai" class="text-danger"></span>
                </div>

                 <div class="mb-3">
                    <label asp-for="CongNgheSuDung" class="form-label">Công nghệ dự kiến sử dụng</label>
                    <input asp-for="CongNgheSuDung" class="form-control" placeholder="Ví dụ: ASP.NET Core, React, SQL Server..." />
                    <span asp-validation-for="CongNgheSuDung" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="GiangVienId" class="form-label">Giảng viên hướng dẫn mong muốn (Tùy chọn)</label>
                    <select asp-for="GiangVienId" class="form-select">
                        <option value="">-- Chọn giảng viên --</option>
                        @foreach (var gv in ViewBag.GiangViens)
                        {
                            <option value="@gv.Id">@gv.HoTen (Giới hạn: @gv.SoLuongSinhVienDangHuongDan/@gv.GioiHanSinhVien)</option>
                        }
                    </select>
                </div>

                <button type="submit" class="btn btn-primary">Gửi đăng ký</button>
                <a asp-action="Dashboard" class="btn btn-secondary">Quay lại</a>
            </form>
        </div>
    </div>
</div>
